# Staging Environment Configuration Template (Phase 5 Isolation)
# DO NOT COMMIT ACTUAL SECRETS. Copy to .env.staging in your secure staging runner.

ENVIRONMENT=staging
DEBUG=false

# Isolated Staging Database (Must NOT point to production)
DATABASE_URL=postgresql://staging_user:staging_password@postgres-staging:5432/staging_smart_farming

# Isolated Staging Cache & Broker
REDIS_URL=redis://redis-staging:6379
REQUIRE_REDIS=true

# Security & Tokens (Generate distinct random 32-byte strings for staging)
SECRET_KEY=staging_secret_key_distinct_from_production_only
JWT_SECRET_KEY=staging_jwt_secret_key_distinct_from_production
CRON_SECRET=staging_cron_webhook_secret_distinct

# Storage Backend
STORAGE_BACKEND=local
DATA_ROOT=/app/data
UPLOAD_ROOT=/app/data/uploads
PROCESSED_ROOT=/app/data/processed
AUDIO_ROOT=/app/data/audio

# CORS Configuration
CORS_ORIGINS=https://staging.smartfarming.example.com,http://localhost:8080

# Monitoring & Error Tracking (Phase 5)
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
PROMETHEUS_METRICS_ENABLED=true

