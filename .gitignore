# ==============================================================================
# Smart Farming Project - Comprehensive .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environments & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
*.env
**/.env
**/.env.*
!**/.env.example
*.local

# ------------------------------------------------------------------------------
# Databases & Local Data Stores
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
dev_database.db
**/dev_database.db

# ------------------------------------------------------------------------------
# Runtime Media & Data Storage (Uploads, Processed images, Audio cache)
# ------------------------------------------------------------------------------
data/
**/data/
**/data/uploads/*
**/data/processed/*
**/data/audio/*
!**/data/uploads/.gitkeep
!**/data/processed/.gitkeep
!**/data/audio/.gitkeep

# ------------------------------------------------------------------------------
# Python & Backend Artifacts
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / Packaging
build/
**/build/
develop-eggs/
dist/
**/dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
**/*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
**/.venv/
env/
**/env/
venv/
**/venv/
ENV/
env.bak/
venv.bak/
cropidentification/

# Testing & Coverage
htmlcov/
.tox/
.nosenv/
.gauge/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
**/.pytest_cache/
cover/

# Linters & Type Checking
.mypy_cache/
**/.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
**/.ruff_cache/
cython_debug/

# PyInstaller / Executable specs
*.manifest
*.spec

# Installer & Celery logs
pip-log.txt
pip-delete-this-directory.txt
celerybeat-schedule
celerybeat.pid

# ------------------------------------------------------------------------------
# Machine Learning & AI Caches
# ------------------------------------------------------------------------------
.cache/
**/.cache/
wandb/
runs/
*.cache
checkpoints/
.gradio/
gradio_cached_examples/

# ------------------------------------------------------------------------------
# Frontend (Node / Vite / React)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.vite/
**/.vite/

# ------------------------------------------------------------------------------
# Mobile (Flutter / Dart / Android / iOS)
# ------------------------------------------------------------------------------
**/doc/api/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/coverage/

# Android Studio / Gradle artifacts
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/app/build/
**/.gradle/
**/local.properties
**/GeneratedPluginRegistrant.java

# iOS / Xcode artifacts
**/ios/Flutter/.last_build_id
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.framework
**/Pods/
**/.symlinks/
**/.plugin_symlinks/
**/.fvm/
**/.widget_preview/
**/.externalNativeBuild/
**/.cxx/
**/captures/
**/DerivedData/
**/derivedData/

# Mobile symbolication & obfuscation
app.*.symbols
app.*.map.json

# ------------------------------------------------------------------------------
# IDEs, Editors & Tooling
# ------------------------------------------------------------------------------
.vscode/
**/.vscode/
.idea/
**/.idea/
*.iml
*.ipr
*.iws
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.atom/
.history
.svn/

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# Project Specific & Deprecated Dirs
# ------------------------------------------------------------------------------
old_files/
.agents/
.fastapicloud/
