# ==============================================================================
# Smart Farming Production Environment Configuration Template (.env.production)
# Architecture: Supabase Database + Supabase Object Storage (Production)
# Project: smart-farming | Bucket: smart-farming-data
# ==============================================================================

ENVIRONMENT=production
DEBUG=False

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database (Production)
# ------------------------------------------------------------------------------
# Copy from Supabase Dashboard (smart-farming project):
# Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.<prod-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
PROD_DATABASE_URL=postgresql://postgres.<prod-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# Supabase Object Storage (Production)
# ------------------------------------------------------------------------------
# Bucket: smart-farming-data (Create this bucket in Supabase Dashboard -> Storage)
# URL:    Project Settings -> API -> Project URL
# Key:    Project Settings -> API -> Project API keys -> 'service_role' secret key
#
STORAGE_BACKEND=supabase
SUPABASE_URL=https://<prod-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_prod_supabase_service_role_secret_key
SUPABASE_BUCKET=smart-farming-data
SUPABASE_SIGNED_URL_EXPIRY_SECONDS=900

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=generate_strong_64_character_random_hex_key_for_production
CORS_ORIGINS=https://your-production-domain.com

# ------------------------------------------------------------------------------
# Redis & Upstash QStash (Production Serverless Queue)
# ------------------------------------------------------------------------------
REQUIRE_REDIS=False
UPSTASH_REDIS_URL=rediss://default:<UPSTASH_REDIS_REST_TOKEN>@<your-db-id>.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://<your-db-id>.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

QSTASH_REGION=US_EAST_1
QSTASH_URL=https://qstash-us-east-1.upstash.io/v2
QSTASH_TOKEN=your_us_east_1_qstash_token
QSTASH_CURRENT_SIGNING_KEY=sig_your_current_signing_key
QSTASH_NEXT_SIGNING_KEY=sig_your_next_signing_key
CRON_SECRET=your_production_internal_cron_secret

# ------------------------------------------------------------------------------
# AI Microservices (Unified Hugging Face Space)
# ------------------------------------------------------------------------------
AI_SERVICE_URL=https://maharsh8805-smart-farming-ai.hf.space
MODEL_SERVER_URL=https://maharsh8805-smart-farming-ai.hf.space/vision
MODEL_SERVER_TIMEOUT=120
TRANSLATION_SERVER_URL=https://maharsh8805-smart-farming-ai.hf.space/translation
TRANSLATION_SERVER_TIMEOUT=45
ADVISORY_SERVER_URL=https://maharsh8805-smart-farming-ai.hf.space/advisory
ADVISORY_SERVER_TIMEOUT=60
TTS_SERVER_URL=https://maharsh8805-smart-farming-ai.hf.space/tts
TTS_SERVER_TIMEOUT=90
GATEWAY_API_KEY=your_production_gateway_api_key

# ------------------------------------------------------------------------------
# External Services & Email (Supabase Custom SMTP)
# ------------------------------------------------------------------------------
OPENWEATHER_API=your_openweather_api_key
# Auth emails dispatched via Supabase Auth custom SMTP
EMAILS_FROM_NAME="Smart Farming Support"
EMAILS_FROM_EMAIL=your_email@gmail.com
FRONTEND_URL=https://your-production-domain.com

