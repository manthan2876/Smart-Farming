# ==============================================================================
# Smart Farming Backend - Environment Configuration Template
# Copy this file to .env and replace placeholder values locally.
# NEVER commit real API keys, secrets, or database passwords to git.
# ==============================================================================

# Database Connection (PostgreSQL or SQLite)
DATABASE_URL=postgresql://user:password@localhost:5432/smart_farming
# Or Supabase: DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Or SQLite: DATABASE_URL=sqlite:///./dev_database.db

# Authentication & Security
JWT_SECRET_KEY=replace_with_a_long_random_jwt_secret_key
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Redis Cache & Task Queue
REDIS_URL=redis://localhost:6379
REQUIRE_REDIS=False

# Upstash Serverless Redis REST (Serverless caching & translation)
UPSTASH_REDIS_REST_URL=https://<your-db-id>.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Model Inference Server (Server 2)
MODEL_SERVER_URL=http://127.0.0.1:8001
MODEL_SERVER_TIMEOUT=60

# External AI & API Services
OPENWEATHER_API=your_openweather_api_key
GEMINI_API_KEY=your_gemini_api_key
HF_TOKEN=your_huggingface_token
GOOGLE_TTS_API_KEY=your_google_text_to_speech_api_key
GOOGLE_TRANSLATION_API_KEY=your_google_translation_api_key

# ------------------------------------------------------------------------------
# Object Storage Configuration (local | s3 | gcs)
# ------------------------------------------------------------------------------
STORAGE_BACKEND=gcs

# For Google Cloud Storage (via S3-compatible HMAC API):
AWS_ACCESS_KEY_ID=GOOG1E...your_gcs_hmac_access_key
AWS_SECRET_ACCESS_KEY=your_gcs_hmac_secret_key
AWS_REGION=auto
AWS_S3_BUCKET=smart-farming-data
AWS_ENDPOINT_URL=https://storage.googleapis.com
S3_PRESIGNED_EXPIRY_SECONDS=900

# For AWS S3:
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-s3-bucket-name
# AWS_ENDPOINT_URL=

# Environment and Debugging
ENVIRONMENT=development
DEBUG=True
