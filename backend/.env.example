# ==============================================================================
# Smart Farming Backend - Environment Configuration Template (.env)
# Architecture: Supabase Database + Supabase Object Storage (Development)
# Project: smart-farming-dev | Bucket: smart-farming-data-dev
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment & Debugging Mode
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database (Development)
# ------------------------------------------------------------------------------
# Copy from Supabase Dashboard: Project Settings -> Database -> Connection string -> URI
# Use the connection pooler (port 5432 or 6543) or direct connection:
DATABASE_URL=postgresql://postgres.<dev-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# Supabase Object Storage (Development)
# ------------------------------------------------------------------------------
# Used for storing raw upload images, Grad-CAM overlays, and voice audio clips.
#
# Bucket: smartfarming-data-dev (Create this bucket in Supabase Dashboard -> Storage)
# URL:    Project Settings -> API -> Project URL
# Key:    Project Settings -> API -> Project API keys -> 'service_role' secret key
#
STORAGE_BACKEND=supabase
SUPABASE_URL=https://<dev-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_dev_supabase_service_role_secret_key
SUPABASE_BUCKET=smart-farming-data-dev
SUPABASE_SIGNED_URL_EXPIRY_SECONDS=900

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=replace_with_a_long_random_jwt_secret_key
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ------------------------------------------------------------------------------
# Redis Queue & Background Workers
# ------------------------------------------------------------------------------
# REQUIRE_REDIS=False -> Uses Upstash Cloud Redis (UPSTASH_REDIS_URL, no local Docker required)
# REQUIRE_REDIS=True  -> Uses Local Docker Redis (LOCAL_REDIS_URL: redis://localhost:6379)
REQUIRE_REDIS=False
LOCAL_REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_URL=rediss://default:<UPSTASH_REDIS_REST_TOKEN>@<your-db-id>.upstash.io:6379
REDIS_URL=

# Upstash Serverless Redis REST (Serverless caching & translation)
UPSTASH_REDIS_REST_URL=https://<your-db-id>.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Upstash QStash (Serverless Scheduled Crons & Webhooks - US East 1)
QSTASH_REGION=US_EAST_1
QSTASH_URL=https://qstash-us-east-1.upstash.io/v2
QSTASH_TOKEN=your_us_east_1_qstash_token
QSTASH_CURRENT_SIGNING_KEY=sig_your_current_signing_key
QSTASH_NEXT_SIGNING_KEY=sig_your_next_signing_key
CRON_SECRET=your_optional_internal_cron_secret

# ------------------------------------------------------------------------------
# AI Microservices / Cloudflare Worker Gateway
# ------------------------------------------------------------------------------
# AI Microservice (Direct Hugging Face Space URL)
# ------------------------------------------------------------------------------
AI_SERVICE_URL=https://<your-space-name>.hf.space
MODEL_SERVER_URL=http://127.0.0.1:8001
MODEL_SERVER_TIMEOUT=120
TRANSLATION_SERVER_URL=http://127.0.0.1:8002
TRANSLATION_SERVER_TIMEOUT=45
ADVISORY_SERVER_URL=http://127.0.0.1:8003
ADVISORY_SERVER_TIMEOUT=60
TTS_SERVER_URL=http://127.0.0.1:8004
TTS_SERVER_TIMEOUT=45
GATEWAY_API_KEY=

# ------------------------------------------------------------------------------
# External API Services
# ------------------------------------------------------------------------------
OPENWEATHER_API=your_openweather_api_key

# ------------------------------------------------------------------------------
# Email Delivery Configuration (Supabase Custom SMTP)
# ------------------------------------------------------------------------------
# Configure custom SMTP in Supabase Dashboard (Auth > Configuration > Emails > Custom SMTP).
# No raw SMTP credentials need to be stored in the codebase or environment files.
EMAILS_FROM_EMAIL=noreply@smartfarming.com
EMAILS_FROM_NAME="Smart Farming Support"
FRONTEND_URL=http://localhost:5173

