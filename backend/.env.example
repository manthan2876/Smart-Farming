# ==============================================================================
# Smart Farming Backend - Environment Configuration Template
# Copy this file to .env and replace placeholder values locally.
# NEVER commit real API keys, secrets, or database passwords to git.
# ==============================================================================

# Database Connections (Separation of Development and Production)
# Development Database (Aiven Cloud PostgreSQL or local SQLite):
DATABASE_URL=postgres://avnadmin:<password>@pg-xxx-smart-farming-dev.f.aivencloud.com:25049/defaultdb?sslmode=require
# Local SQLite fallback:
# DATABASE_URL=sqlite:///./dev_database.db

# Deployed Production Database (Supabase Pooler):
PROD_DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Authentication & Security
JWT_SECRET_KEY=replace_with_a_long_random_jwt_secret_key
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Redis Queue Toggle:
# REQUIRE_REDIS=False -> Uses Upstash Cloud Redis (UPSTASH_REDIS_URL, no local Docker required)
# REQUIRE_REDIS=True  -> Uses Local Docker Redis (LOCAL_REDIS_URL: redis://localhost:6379)
REQUIRE_REDIS=False
LOCAL_REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_URL=rediss://default:<UPSTASH_REDIS_REST_TOKEN>@<your-db-id>.upstash.io:6379
REDIS_URL=

# Upstash Serverless Redis REST (Serverless caching & translation)
UPSTASH_REDIS_REST_URL=https://<your-db-id>.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Upstash QStash (Serverless Scheduled Crons & Webhooks - US East 1)
QSTASH_REGION=US_EAST_1
QSTASH_URL=https://qstash-us-east-1.upstash.io/v2
QSTASH_TOKEN=your_us_east_1_qstash_token
QSTASH_CURRENT_SIGNING_KEY=sig_your_current_signing_key
QSTASH_NEXT_SIGNING_KEY=sig_your_next_signing_key
CRON_SECRET=your_optional_internal_cron_secret


# AI Microservices / Cloudflare Worker Gateway
# When using Cloudflare Worker Gateway (Option B), use:
# MODEL_SERVER_URL=https://smart-farming-gateway.<YOUR-SUBDOMAIN>.workers.dev/vision
# TRANSLATION_SERVER_URL=https://smart-farming-gateway.<YOUR-SUBDOMAIN>.workers.dev/translation
# ADVISORY_SERVER_URL=https://smart-farming-gateway.<YOUR-SUBDOMAIN>.workers.dev/advisory
# GATEWAY_API_KEY=your_cloudflare_worker_secret_key
MODEL_SERVER_URL=http://127.0.0.1:8001
MODEL_SERVER_TIMEOUT=120
TRANSLATION_SERVER_URL=http://127.0.0.1:8002
TRANSLATION_SERVER_TIMEOUT=45
ADVISORY_SERVER_URL=http://127.0.0.1:8003
ADVISORY_SERVER_TIMEOUT=60
TTS_SERVER_URL=http://127.0.0.1:8004
TTS_SERVER_TIMEOUT=45
GATEWAY_API_KEY=

# External AI & API Services
OPENWEATHER_API=your_openweather_api_key
GEMINI_API_KEY=your_gemini_api_key
HF_TOKEN=your_huggingface_token
GOOGLE_TRANSLATION_API_KEY=your_google_translation_api_key

# ------------------------------------------------------------------------------
# Object Storage Configuration (local | s3)
# ------------------------------------------------------------------------------
STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=smart-farming-data
AWS_ENDPOINT_URL=
S3_PRESIGNED_EXPIRY_SECONDS=900

# Environment and Debugging
ENVIRONMENT=development
DEBUG=True

# Email / SMTP Configuration (for Forgot/Reset Password)
# Leave empty for console fallback during local development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_TLS=True
SMTP_SSL=False
EMAILS_FROM_EMAIL=noreply@smartfarming.com
EMAILS_FROM_NAME="Smart Farming Support"
FRONTEND_URL=http://localhost:5173

