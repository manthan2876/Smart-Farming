# ==============================================================================
# Git Attributes configuration for Smart Farming Project
# ==============================================================================

# ------------------------------------------------------------------------------
# Auto-detect text files and normalize line endings
# ------------------------------------------------------------------------------
* text=auto eol=lf

# Explicit LF line endings for Linux/Unix scripts and web files
*.sh text eol=lf
*.bash text eol=lf

# Explicit CRLF line endings for Windows batch & PowerShell scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Source code diff drivers and line endings
*.py text diff=python eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.dart text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.txt text eol=lf

# Binary media and font files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary

# ------------------------------------------------------------------------------
# Git LFS (Large File Storage) for ML Models, Weights, Datasets and Archives
# ------------------------------------------------------------------------------
# Machine learning / Deep learning model weights & checkpoints
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.joblib filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.tflite filter=lfs diff=lfs merge=lfs -text
*.weights filter=lfs diff=lfs merge=lfs -text
*.mlmodel filter=lfs diff=lfs merge=lfs -text

# Compressed archives & dataset packages
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.tgz filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.rar filter=lfs diff=lfs merge=lfs -text
*.gz filter=lfs diff=lfs merge=lfs -text

# Data serialization formats
*.parquet filter=lfs diff=lfs merge=lfs -text
*.feather filter=lfs diff=lfs merge=lfs -text
*.arrow filter=lfs diff=lfs merge=lfs -text

# Audio / video recordings
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text

# Specific repository dataset directories
"Datasets/**" filter=lfs diff=lfs merge=lfs -text
"datasets/**" filter=lfs diff=lfs merge=lfs -text

# Dedicated model inference microservice: keep models & labels directly in Git
# All model checkpoints are under 32MB (< 100MB GitHub limit).
# Direct tracking allows Google Cloud Build to clone actual model weights & labels without Git LFS auth.
model_service/models/** -filter -diff -merge
model_service/models/*.pth binary -filter -diff -merge
model_service/models/*.pt binary -filter -diff -merge
model_service/models/pest_classifier/*.pt binary -filter -diff -merge
model_service/models/*.json text eol=lf diff -filter -merge
model_service/models/csvs/* text eol=lf diff -filter -merge
model_service/models/matrixes/* binary -filter -diff -merge